# Uploaded media is data, never executable code.
Options -Indexes -ExecCGI

<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh
</IfModule>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml|html?|svg|xml)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>
